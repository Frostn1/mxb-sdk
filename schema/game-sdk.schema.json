{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mxbapp.dev/schema/game-sdk/1",
  "title": "MX Bikes Game SDK schema",
  "description": "Public snapshots, events, and version handshake for schema 1.",
  "x-schema-version": 1,
  "x-sdk-version": "1.2.0",
  "x-deprecated": [],
  "$defs": {
    "Phase": { "description": "The current session phase.", "type": "string", "enum": ["waiting", "practice", "qualifying", "warmup", "race", "unknown"] },
    "Capability": { "description": "An enabled server capability.", "type": "string", "enum": ["state", "events", "laps", "stream", "mcp"] },
    "Deprecation": { "description": "A public path scheduled for removal.", "type": "object", "additionalProperties": false, "required": ["path", "since", "removeIn", "use"], "properties": {
      "path": { "description": "Deprecated public path.", "type": "string" }, "since": { "description": "SDK minor version that deprecated it.", "type": "string" }, "removeIn": { "description": "Next major version that may remove it.", "type": "string" }, "use": { "description": "Replacement public path or operation.", "type": "string" }
    }},
    "Snapshot": {
      "description": "One frame of game state.", "type": "object", "additionalProperties": false,
      "required": ["schema", "frame", "at", "source", "online", "session", "local", "riders"],
      "properties": {
        "schema": { "description": "Schema major version.", "type": "integer" },
        "frame": { "description": "Frame number, increasing for every snapshot.", "type": "integer" },
        "at": { "description": "Snapshot time in Unix ms.", "type": "integer" },
        "source": { "description": "Origin of this frame.", "type": "string", "enum": ["live", "replay", "none"] },
        "online": { "description": "Whether this is an online session.", "type": "boolean" },
        "session": { "description": "Current event and session, or null.", "type": ["object", "null"], "oneOf": [{ "$ref": "#/$defs/Session" }, { "type": "null" }] },
        "local": { "description": "The player's bike, or null when off track.", "type": ["object", "null"], "oneOf": [{ "$ref": "#/$defs/Local" }, { "type": "null" }] },
        "riders": { "description": "Riders in timing-screen order.", "type": "array", "items": { "$ref": "#/$defs/Rider" } }
      }
    },
    "Session": {
      "description": "The current event and session.", "type": "object", "additionalProperties": false,
      "required": ["trackId", "trackName", "trackLength", "eventType", "server", "phase", "session", "state", "lengthMs", "laps", "clockMs", "weather", "airTempC"],
      "properties": {
        "trackId": { "description": "Track folder identifier.", "type": "string" }, "trackName": { "description": "Display name of the track.", "type": "string" },
        "trackLength": { "description": "Centreline length in metres.", "type": "number" }, "eventType": { "description": "Kind of event.", "type": "string", "enum": ["testing", "race", "straight_rhythm", "unknown"] },
        "server": { "description": "Server name online, null offline.", "type": ["string", "null"] }, "phase": { "description": "Derived session phase.", "$ref": "#/$defs/Phase" },
        "session": { "description": "Raw game session index.", "type": "integer" }, "state": { "description": "Raw game session-state bits.", "type": "integer" },
        "lengthMs": { "description": "Time limit in ms, or zero.", "type": "integer" }, "laps": { "description": "Lap limit, or zero.", "type": "integer" },
        "clockMs": { "description": "Timing-screen clock in ms, or null.", "type": ["integer", "null"] }, "weather": { "description": "Weather, or null before going on track.", "type": ["string", "null"], "enum": ["clear", "cloudy", "rain", null] },
        "airTempC": { "description": "Air temperature in degrees Celsius, or null.", "type": ["number", "null"] }
      }
    },
    "Local": {
      "description": "The local rider's live telemetry.", "type": "object", "additionalProperties": false,
      "required": ["name", "raceNum", "bike", "onTrack", "trackTime", "lapProgress", "speedKmh", "rpm", "gear", "throttle", "frontBrake", "rearBrake", "clutch", "steerDeg", "suspension", "position", "velocity", "accelG", "yawDeg", "pitchDeg", "rollDeg", "airborne", "crashed", "engineTempC", "waterTempC", "fuelL", "lap"],
      "properties": {
        "name": { "description": "Rider name.", "type": "string" }, "raceNum": { "description": "Race number, or null before known.", "type": ["integer", "null"] }, "bike": { "description": "Current bike.", "$ref": "#/$defs/Bike" }, "onTrack": { "description": "Whether the run is active.", "type": "boolean" },
        "trackTime": { "description": "On-track time in seconds.", "type": "number" }, "lapProgress": { "description": "Progress around the lap from 0 to 1.", "type": "number" }, "speedKmh": { "description": "Speed in km/h.", "type": "number" }, "rpm": { "description": "Engine speed in rpm.", "type": "integer" }, "gear": { "description": "Selected gear; zero is neutral.", "type": "integer" },
        "throttle": { "description": "Throttle input from 0 to 1.", "type": "number" }, "frontBrake": { "description": "Front brake input from 0 to 1.", "type": "number" }, "rearBrake": { "description": "Rear brake input from 0 to 1.", "type": "number" }, "clutch": { "description": "Clutch input; 0 engaged and 1 pulled in.", "type": "number" }, "steerDeg": { "description": "Steering angle in degrees; negative is right.", "type": "number" },
        "suspension": { "description": "Suspension position and travel.", "$ref": "#/$defs/Suspension" }, "position": { "description": "World position in metres; y is up.", "type": "array", "prefixItems": [{"type":"number"},{"type":"number"},{"type":"number"}], "items": false }, "velocity": { "description": "World velocity in metres per second.", "type": "array", "prefixItems": [{"type":"number"},{"type":"number"},{"type":"number"}], "items": false }, "accelG": { "description": "Chassis-frame acceleration in G.", "type": "array", "prefixItems": [{"type":"number"},{"type":"number"},{"type":"number"}], "items": false },
        "yawDeg": { "description": "Yaw in degrees.", "type": "number" }, "pitchDeg": { "description": "Pitch in degrees.", "type": "number" }, "rollDeg": { "description": "Roll in degrees.", "type": "number" }, "airborne": { "description": "Whether both wheels are airborne.", "type": "boolean" }, "crashed": { "description": "Whether the bike is down.", "type": "boolean" },
        "engineTempC": { "description": "Engine temperature in degrees Celsius.", "type": "number" }, "waterTempC": { "description": "Water temperature in degrees Celsius.", "type": "number" }, "fuelL": { "description": "Fuel in litres.", "type": "number" }, "lap": { "description": "Current-run lap timing.", "$ref": "#/$defs/LapNow" }
      }
    },
    "Bike": { "description": "The local bike.", "type": "object", "additionalProperties": false, "required": ["id","name","category","gears","maxRpm","limiterRpm","shiftRpm"], "properties": {
      "id": {"description":"Bike folder identifier.","type":"string"}, "name": {"description":"Bike display name.","type":"string"}, "category": {"description":"Bike category.","type":"string"}, "gears": {"description":"Number of forward gears.","type":"integer"}, "maxRpm": {"description":"Maximum engine rpm.","type":"integer"}, "limiterRpm": {"description":"Limiter engine rpm.","type":"integer"}, "shiftRpm": {"description":"Suggested shift engine rpm.","type":"integer"}
    }},
    "Suspension": { "description": "Suspension compression and shock length.", "type": "object", "additionalProperties": false, "required": ["front","rear","frontM","rearM"], "properties": {
      "front": {"description":"Front compression from 0 to 1, or null if travel is unknown.","type":["number","null"]}, "rear": {"description":"Rear compression from 0 to 1, or null if travel is unknown.","type":["number","null"]}, "frontM": {"description":"Front shock length in metres.","type":"number"}, "rearM": {"description":"Rear shock length in metres.","type":"number"}
    }},
    "LapNow": { "description": "Timing for the current run.", "type": "object", "additionalProperties": false, "required": ["completed","lastMs","bestMs","splitsMs","currentMs"], "properties": {
      "completed": {"description":"Laps completed this run.","type":"integer"}, "lastMs": {"description":"Last lap in ms, or null.","type":["integer","null"]}, "bestMs": {"description":"Best valid lap in ms, or null.","type":["integer","null"]}, "splitsMs": {"description":"Current-lap splits in ms from the line.","type":"array","items":{"type":"integer"}}, "currentMs": {"description":"Current lap time in ms, or null before the first crossing.","type":["integer","null"]}
    }},
    "Rider": { "description": "One timing-screen rider.", "type": "object", "additionalProperties": false, "required": ["raceNum","name","bike","category","active","local","place","laps","bestLapMs","lastLapMs","gapMs","gapLaps","penaltyMs","status","track"], "properties": {
      "raceNum":{"description":"Race number.","type":"integer"}, "name":{"description":"Rider name.","type":"string"}, "bike":{"description":"Bike name.","type":"string"}, "category":{"description":"Bike category.","type":"string"}, "active":{"description":"False after the rider leaves.","type":"boolean"}, "local":{"description":"Whether this is the player.","type":"boolean"}, "place":{"description":"Timing-screen place, or null.","type":["integer","null"]}, "laps":{"description":"Completed laps, or null.","type":["integer","null"]}, "bestLapMs":{"description":"Best lap in ms, or null.","type":["integer","null"]}, "lastLapMs":{"description":"Last lap in ms, or null.","type":["integer","null"]}, "gapMs":{"description":"Gap to leader in ms, or null.","type":["integer","null"]}, "gapLaps":{"description":"Gap to leader in laps, or null.","type":["integer","null"]}, "penaltyMs":{"description":"Penalty in ms, or null.","type":["integer","null"]}, "status":{"description":"Raw rider status, or null.","type":["integer","null"]}, "track":{"description":"Track position, withheld online for other riders.","type":["object","null"],"oneOf":[{"$ref":"#/$defs/TrackSpot"},{"type":"null"}]}
    }},
    "TrackSpot": { "description": "A rider's position on track.", "type": "object", "additionalProperties": false, "required": ["progress","position","yawDeg","crashed"], "properties": {
      "progress":{"description":"Progress around the lap from 0 to 1.","type":"number"}, "position":{"description":"World position in metres.","type":"array","prefixItems":[{"type":"number"},{"type":"number"},{"type":"number"}],"items":false}, "yawDeg":{"description":"Yaw in degrees.","type":"number"}, "crashed":{"description":"Whether the rider is down.","type":"boolean"}
    }},
    "LapRecord": { "description": "One completed local lap with telemetry statistics.", "type":"object", "additionalProperties":false, "required":["lap","timeMs","valid","best","splitsMs","topSpeedKmh","avgSpeedKmh","airtimeS","crashes","track","bike","at"], "properties": {
      "lap":{"description":"One-based lap number.","type":"integer"}, "timeMs":{"description":"Lap time in ms.","type":"integer"}, "valid":{"description":"Whether the lap is valid.","type":"boolean"}, "best":{"description":"Whether the game marked a personal best.","type":"boolean"}, "splitsMs":{"description":"Split times in ms.","type":"array","items":{"type":"integer"}}, "topSpeedKmh":{"description":"Top speed in km/h.","type":"number"}, "avgSpeedKmh":{"description":"Average speed in km/h.","type":"number"}, "airtimeS":{"description":"Time airborne in seconds.","type":"number"}, "crashes":{"description":"Crash count during the lap.","type":"integer"}, "track":{"description":"Track name.","type":"string"}, "bike":{"description":"Bike name.","type":"string"}, "at":{"description":"Completion time in Unix ms.","type":"integer"}
    }},
    "Hello": { "description":"Server version and capability handshake.", "type":"object", "additionalProperties":false, "required":["schema","sdk","app","capabilities","deprecated"], "properties": {
      "schema":{"description":"Schema major version.","type":"integer"}, "sdk":{"description":"SDK semantic version.","type":"string"}, "app":{"description":"MXB App version.","type":"string"}, "capabilities":{"description":"Enabled endpoint capabilities.","type":"array","items":{"$ref":"#/$defs/Capability"}}, "deprecated":{"description":"Public paths scheduled for removal.","type":"array","items":{"$ref":"#/$defs/Deprecation"}}
    }},
    "GameEvent": {
      "description":"An event emitted by the engine.",
      "unevaluatedProperties": false,
      "oneOf": [
        {"$ref":"#/$defs/EventStart"},{"$ref":"#/$defs/EventEnd"},{"$ref":"#/$defs/OnTrack"},{"$ref":"#/$defs/OffTrack"},{"$ref":"#/$defs/SessionStart"},{"$ref":"#/$defs/SessionState"},{"$ref":"#/$defs/SessionEnd"},{"$ref":"#/$defs/LapEvent"},{"$ref":"#/$defs/SplitEvent"},{"$ref":"#/$defs/CrashEvent"},{"$ref":"#/$defs/RecoverEvent"},{"$ref":"#/$defs/HoleshotEvent"},{"$ref":"#/$defs/OvertakeEvent"},{"$ref":"#/$defs/RiderJoinEvent"},{"$ref":"#/$defs/RiderLeaveEvent"},{"$ref":"#/$defs/CommunicationEvent"}
      ]
    },
    "EventStart":{"description":"The player joined an event.","type":"object","required":["seq","at","type","track","server"],"properties":{"seq":{"description":"Event sequence number.","type":"integer"},"at":{"description":"Event time in Unix ms.","type":"integer"},"type":{"description":"Event discriminator.","const":"event_start"},"raceNum":{"description":"Related race number.","type":"integer"},"local":{"description":"Whether this concerns the player.","type":"boolean"},"track":{"description":"Track name.","type":"string"},"server":{"description":"Server name, or null offline.","type":["string","null"]}}},
    "EventEnd":{"description":"The current event ended.","type":"object","required":["seq","at","type"],"properties":{"seq":{"description":"Event sequence number.","type":"integer"},"at":{"description":"Event time in Unix ms.","type":"integer"},"type":{"description":"Event discriminator.","const":"event_end"},"raceNum":{"description":"Related race number.","type":"integer"},"local":{"description":"Whether this concerns the player.","type":"boolean"}}},
    "OnTrack":{"description":"The player went on track.","type":"object","required":["seq","at","type"],"properties":{"seq":{"description":"Event sequence number.","type":"integer"},"at":{"description":"Event time in Unix ms.","type":"integer"},"type":{"description":"Event discriminator.","const":"on_track"},"raceNum":{"description":"Related race number.","type":"integer"},"local":{"description":"Whether this concerns the player.","type":"boolean"}}},
    "OffTrack":{"description":"The player left the track.","type":"object","required":["seq","at","type"],"properties":{"seq":{"description":"Event sequence number.","type":"integer"},"at":{"description":"Event time in Unix ms.","type":"integer"},"type":{"description":"Event discriminator.","const":"off_track"},"raceNum":{"description":"Related race number.","type":"integer"},"local":{"description":"Whether this concerns the player.","type":"boolean"}}},
    "SessionStart":{"description":"A session started.","type":"object","required":["seq","at","type","phase","session"],"properties":{"seq":{"description":"Event sequence number.","type":"integer"},"at":{"description":"Event time in Unix ms.","type":"integer"},"type":{"description":"Event discriminator.","const":"session_start"},"raceNum":{"description":"Related race number.","type":"integer"},"local":{"description":"Whether this concerns the player.","type":"boolean"},"phase":{"description":"Session phase.","$ref":"#/$defs/Phase"},"session":{"description":"Raw session index.","type":"integer"}}},
    "SessionState":{"description":"The session state changed.","type":"object","required":["seq","at","type","session","state"],"properties":{"seq":{"description":"Event sequence number.","type":"integer"},"at":{"description":"Event time in Unix ms.","type":"integer"},"type":{"description":"Event discriminator.","const":"session_state"},"raceNum":{"description":"Related race number.","type":"integer"},"local":{"description":"Whether this concerns the player.","type":"boolean"},"session":{"description":"Raw session index.","type":"integer"},"state":{"description":"Raw session-state bits.","type":"integer"}}},
    "SessionEnd":{"description":"A session completed.","type":"object","required":["seq","at","type","session"],"properties":{"seq":{"description":"Event sequence number.","type":"integer"},"at":{"description":"Event time in Unix ms.","type":"integer"},"type":{"description":"Event discriminator.","const":"session_end"},"raceNum":{"description":"Related race number.","type":"integer"},"local":{"description":"Whether this concerns the player.","type":"boolean"},"session":{"description":"Raw session index.","type":"integer"}}},
    "LapEvent":{"description":"A rider completed a lap.","type":"object","required":["seq","at","type","lap","timeMs","valid","best"],"properties":{"seq":{"description":"Event sequence number.","type":"integer"},"at":{"description":"Event time in Unix ms.","type":"integer"},"type":{"description":"Event discriminator.","const":"lap"},"raceNum":{"description":"Related race number.","type":"integer"},"local":{"description":"Whether this concerns the player.","type":"boolean"},"lap":{"description":"One-based lap number.","type":"integer"},"timeMs":{"description":"Lap time in ms.","type":"integer"},"valid":{"description":"Whether the lap is valid.","type":"boolean"},"best":{"description":"Whether it is a personal best.","type":"boolean"},"splitsMs":{"description":"Local lap splits in ms.","type":"array","items":{"type":"integer"}},"topSpeedKmh":{"description":"Local lap top speed in km/h.","type":"number"},"avgSpeedKmh":{"description":"Local lap average speed in km/h.","type":"number"},"overallBest":{"description":"Whether a remote lap is the overall best.","type":"boolean"}}},
    "SplitEvent":{"description":"A rider crossed a split.","type":"object","required":["seq","at","type","split","timeMs"],"properties":{"seq":{"description":"Event sequence number.","type":"integer"},"at":{"description":"Event time in Unix ms.","type":"integer"},"type":{"description":"Event discriminator.","const":"split"},"raceNum":{"description":"Related race number.","type":"integer"},"local":{"description":"Whether this concerns the player.","type":"boolean"},"split":{"description":"Zero-based split index.","type":"integer"},"timeMs":{"description":"Time from the line in ms.","type":"integer"},"bestDiffMs":{"description":"Local difference to best in ms.","type":"integer"}}},
    "CrashEvent":{"description":"A rider crashed.","type":"object","required":["seq","at","type"],"properties":{"seq":{"description":"Event sequence number.","type":"integer"},"at":{"description":"Event time in Unix ms.","type":"integer"},"type":{"description":"Event discriminator.","const":"crash"},"raceNum":{"description":"Related race number.","type":"integer"},"local":{"description":"Whether this concerns the player.","type":"boolean"}}},
    "RecoverEvent":{"description":"A rider recovered from a crash.","type":"object","required":["seq","at","type"],"properties":{"seq":{"description":"Event sequence number.","type":"integer"},"at":{"description":"Event time in Unix ms.","type":"integer"},"type":{"description":"Event discriminator.","const":"recover"},"raceNum":{"description":"Related race number.","type":"integer"},"local":{"description":"Whether this concerns the player.","type":"boolean"}}},
    "HoleshotEvent":{"description":"Derived first-split leader.","type":"object","required":["seq","at","type","name","derived"],"properties":{"seq":{"description":"Event sequence number.","type":"integer"},"at":{"description":"Event time in Unix ms.","type":"integer"},"type":{"description":"Event discriminator.","const":"holeshot"},"raceNum":{"description":"Related race number.","type":"integer"},"local":{"description":"Whether this concerns the player.","type":"boolean"},"name":{"description":"Leader name, or null.","type":["string","null"]},"derived":{"description":"Always true because this event is derived.","const":true}}},
    "OvertakeEvent":{"description":"A rider gained places.","type":"object","required":["seq","at","type","place","passed"],"properties":{"seq":{"description":"Event sequence number.","type":"integer"},"at":{"description":"Event time in Unix ms.","type":"integer"},"type":{"description":"Event discriminator.","const":"overtake"},"raceNum":{"description":"Related race number.","type":"integer"},"local":{"description":"Whether this concerns the player.","type":"boolean"},"place":{"description":"New race place.","type":"integer"},"passed":{"description":"Race numbers passed.","type":"array","items":{"type":"integer"}}}},
    "RiderJoinEvent":{"description":"A rider joined.","type":"object","required":["seq","at","type","name"],"properties":{"seq":{"description":"Event sequence number.","type":"integer"},"at":{"description":"Event time in Unix ms.","type":"integer"},"type":{"description":"Event discriminator.","const":"rider_join"},"raceNum":{"description":"Related race number.","type":"integer"},"local":{"description":"Whether this concerns the player.","type":"boolean"},"name":{"description":"Rider name, or null.","type":["string","null"]}}},
    "RiderLeaveEvent":{"description":"A rider left.","type":"object","required":["seq","at","type","name"],"properties":{"seq":{"description":"Event sequence number.","type":"integer"},"at":{"description":"Event time in Unix ms.","type":"integer"},"type":{"description":"Event discriminator.","const":"rider_leave"},"raceNum":{"description":"Related race number.","type":"integer"},"local":{"description":"Whether this concerns the player.","type":"boolean"},"name":{"description":"Rider name, or null.","type":["string","null"]}}},
    "CommunicationEvent":{"description":"A race-control message.","type":"object","required":["seq","at","type","what","penalty","seconds"],"properties":{"seq":{"description":"Event sequence number.","type":"integer"},"at":{"description":"Event time in Unix ms.","type":"integer"},"type":{"description":"Event discriminator.","const":"communication"},"raceNum":{"description":"Related race number.","type":"integer"},"local":{"description":"Whether this concerns the player.","type":"boolean"},"what":{"description":"Communication kind.","type":"string","enum":["retired","disqualified","penalty","notice"]},"penalty":{"description":"Penalty kind, or null.","type":["string","null"],"enum":["jump_start","cutting",null]},"seconds":{"description":"Penalty seconds, or null.","type":["integer","null"]}}}
  }
}
